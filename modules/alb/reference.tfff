      content_type = "text/html"
      message_body = "<h1>Hi, I am from HTTPS Frontend ALB</h1>"
      status_code  = "200"
    }

    default_action {
      type             = "forward"
      target_group_arn = aws_lb_target_group.frontend.arn
    }

  }
}


